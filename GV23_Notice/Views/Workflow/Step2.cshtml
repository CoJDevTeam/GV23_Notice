@model GV23_Notice.Models.Workflow.ViewModels.WorkflowStep2Vm
@using GV23_Notice.Domain.Workflow
@{
    ViewData["Title"] = "Notice Preview";

    bool isInvalid = Model.Notice == NoticeKind.IN;
    bool isS52 = Model.Notice == NoticeKind.S52;
    bool isTpa = Model.Notice == NoticeKind.TPA;
    bool isCla = Model.Notice == NoticeKind.CLA_TPA;
    bool isDirect = isTpa || isCla;

    // Only real content variants remain (Invalid: Omission/Objection, S52: Appeal/Review).
    // PDF "modes" (Single / Email Multi / Split PDF) are removed from the UI.
    string selectedVariant = string.IsNullOrWhiteSpace(Model.SelectedVariant) ? "Default" : Model.SelectedVariant.Trim();
    string VariantUrl(string variant) =>
        Url.Action("Step2", "Workflow", new { settingsId = Model.SettingsId, variant, mode = "single", appealNo = Model.AppealNo }) ?? "#";

    bool hasSignature = !string.IsNullOrWhiteSpace(Model.SignaturePath);
    bool needsSignature = Model.Notice == NoticeKind.S49;
    bool alreadyApproved = Model.Step2Approved && Model.ApprovalKey.HasValue && Model.ApprovalKey != Guid.Empty;
    bool canApprove = Model.PreviewFound && Model.IsApproved && (!needsSignature || hasSignature);

    string NoticeName(NoticeKind n) => n switch
    {
        NoticeKind.S49 => "Section 49 — Public Inspection and Objections",
        NoticeKind.S51 => "Section 51 — Objection Outcome",
        NoticeKind.S52 => "Section 52 — Appeal Notices",
        NoticeKind.S53 => "Section 53 — Municipal Valuer's Decision",
        NoticeKind.S53Rev => "Section 53 — Revised Municipal Valuer's Decision",
        NoticeKind.DJ => "Dear Johnny — Acknowledgement Notice",
        NoticeKind.IN => "Invalid Objection or Omission Notice",
        NoticeKind.S78 => "Section 78 — Property Verification Review",
        NoticeKind.TPA => "Third-Party Appeal Application",
        NoticeKind.CLA_TPA => "CLA Third-Party Application Notice",
        _ => n.ToString()
    };

    // ONE closing date per notice — the full list lives in the Date Summary modal
    (string Label, DateTime? Date)? closing = Model.Notice switch
    {
        NoticeKind.S49 => ("Objection period closes", Model.ExtensionDate ?? Model.ObjectionEndDate),
        NoticeKind.S51 => ("Evidence closing date", Model.EvidenceCloseDate),
        NoticeKind.S53 or NoticeKind.S53Rev => ("Appeal closing date", Model.AppealCloseDate),
        NoticeKind.S78 => ("Review period closes", Model.ReviewCloseDate),
        NoticeKind.CLA_TPA => ("Representation period closes", Model.ObjectionEndDate ?? Model.LetterDate.AddDays(30)),
        _ => null
    };

    var summaryUrl = Url.Action("Step1Summary", "Workflow", new { settingsId = Model.SettingsId, partial = true });
    var batchesUrl = alreadyApproved
        ? Url.Action("Step3Kickoff", "Workflow", new { settingsId = Model.SettingsId, key = Model.ApprovalKey, variant = selectedVariant, mode = "single" })
        : null;
}

<div class="en-page">

    <!-- Header -->
    <div class="en-pagehead">
        <div style="min-width:0">
            <div class="en-eyebrow">Step 2 of 3</div>
            <h1 class="en-title">Notice Preview</h1>
            <p class="en-sub">@NoticeName(Model.Notice) · @Model.RollShortCode — @Model.RollName · Version @Model.Version</p>
        </div>
        <div class="en-actions">
            <a class="en-btn en-btn-ghost" asp-controller="Workflow" asp-action="Step1" asp-route-settingsId="@Model.SettingsId">← Back to Date Configuration</a>
        </div>
    </div>

    <!-- Stepper -->
    <div class="en-stepper" aria-label="Progress">
        <div class="en-step done"><span class="en-step-num">✓</span> Date Configuration</div>
        <div class="en-step-line"></div>
        <div class="en-step @(alreadyApproved ? "done" : "active")"><span class="en-step-num">@(alreadyApproved ? "✓" : "2")</span> Notice Preview</div>
        <div class="en-step-line"></div>
        <div class="en-step @(alreadyApproved ? "active" : "")"><span class="en-step-num">3</span> Batches, Printing and Sending</div>
    </div>

    <!-- Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="en-alert en-alert-ok" role="status">✓ <div>@TempData["Success"]</div></div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="en-alert en-alert-warn" role="status">! <div>@TempData["Warning"]</div></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="en-alert en-alert-err" role="alert">✕ <div>@TempData["Error"]</div></div>
    }

    <!-- Variant switch (content variants only) -->
    @if (isInvalid)
    {
        <div class="en-tabs" role="tablist" aria-label="Notice type">
            <a class="en-tab @(selectedVariant == "InvalidObjection" || selectedVariant == "Default" ? "active" : "")" href="@VariantUrl("InvalidObjection")">Invalid Objection</a>
            <a class="en-tab @(selectedVariant == "InvalidOmission" ? "active" : "")" href="@VariantUrl("InvalidOmission")">Invalid Omission</a>
        </div>
    }
    else if (isS52)
    {
        <div class="en-tabs" role="tablist" aria-label="Notice type">
            <a class="en-tab @(Model.S52CanShowAppealDecision ? "" : "disabled") @(selectedVariant == "S52Appeal" || selectedVariant == "Default" ? "active" : "")"
               href="@VariantUrl("S52Appeal")" title="@(Model.S52CanShowAppealDecision ? "" : "Not selected in Date Configuration")">Appeal Decision</a>
            <a class="en-tab @(Model.S52CanShowReview ? "" : "disabled") @(selectedVariant == "S52Review" ? "active" : "")"
               href="@VariantUrl("S52Review")" title="@(Model.S52CanShowReview ? "" : "Not selected in Date Configuration")">Section 52 Review</a>
        </div>
        @if (Model.S52CanShowAppealDecision && Model.S52CanShowReview)
        {
            <p class="en-sub" style="margin:-8px 0 14px">Both notice types are included — check each tab before approving.</p>
        }
    }

    @if (!Model.PreviewFound)
    {
        @await Html.PartialAsync("_NotFoundPartial", Model)
    }
    else
    {
        <div class="en-preview">

            <!-- PDF -->
            <section class="en-card" aria-label="Notice PDF preview">
                <div class="en-card-head">
                    <h2 class="en-card-title">Notice PDF</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.PdfUrl))
                    {
                        <a class="en-btn-link" href="@Model.PdfUrl" target="_blank" rel="noopener">Open in new tab ↗</a>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.PdfUrl))
                {
                    <iframe class="en-preview-pdf" src="@Model.PdfUrl" title="Notice PDF preview"></iframe>
                }
                else
                {
                    <div class="en-card-body">@await Html.PartialAsync("_NotFoundPartial", Model)</div>
                }
                <div class="en-card-foot">
                    Sample notice for <strong>@Model.RecipientName</strong>. Every recipient gets their own details when the notices are printed.
                </div>
            </section>

            <!-- Checklist + action -->
            <aside class="en-side">
                <section class="en-card">
                    <div class="en-card-head">
                        <h2 class="en-card-title">Checklist</h2>
                        <button type="button" class="en-btn-link" data-en-open-url="@summaryUrl">View date summary</button>
                    </div>
                    <div class="en-card-body">
                        <ul class="en-checklist">
                            <li>
                                <span class="en-tick @(Model.IsApproved ? "ok" : "warn")">@(Model.IsApproved ? "✓" : "!")</span>
                                <span class="en-check-label">
                                    Dates @(Model.IsApproved ? "approved" : "not approved yet")
                                    <span class="en-check-note">Version @Model.Version</span>
                                </span>
                            </li>
                            <li>
                                <span class="en-tick ok">✓</span>
                                <span class="en-check-label">
                                    @(isCla ? "Notification letter date" : isTpa ? "Estimated send date" : "Letter date")
                                    <span class="en-check-val">@Model.LetterDate.ToString("dd MMMM yyyy")</span>
                                </span>
                            </li>
                            @if (closing is { } c)
                            {
                                <li>
                                    <span class="en-tick @(c.Date.HasValue ? "ok" : "warn")">@(c.Date.HasValue ? "✓" : "!")</span>
                                    <span class="en-check-label">
                                        @c.Label
                                        <span class="en-check-val">@(c.Date?.ToString("dd MMMM yyyy") ?? "Not set")</span>
                                    </span>
                                </li>
                            }
                            @if (isTpa)
                            {
                                <li>
                                    <span class="en-tick ok">✓</span>
                                    <span class="en-check-label">
                                        Owner response period
                                        <span class="en-check-val">51 calendar days from the day it is sent</span>
                                    </span>
                                </li>
                            }
                            @if (needsSignature || hasSignature)
                            {
                                <li>
                                    <span class="en-tick @(hasSignature ? "ok" : "warn")">@(hasSignature ? "✓" : "!")</span>
                                    <span class="en-check-label">
                                        Signature @(hasSignature ? "uploaded" : "missing")
                                        @if (!hasSignature)
                                        {
                                            <span class="en-check-note">Required — upload it in Date Configuration.</span>
                                        }
                                    </span>
                                </li>
                            }
                            <li>
                                <span class="en-tick ok">✓</span>
                                <span class="en-check-label">Notice preview created</span>
                            </li>
                            <li>
                                <span class="en-tick @(alreadyApproved ? "ok" : "todo")">@(alreadyApproved ? "✓" : "")</span>
                                <span class="en-check-label">
                                    Notice preview @(alreadyApproved ? "approved" : "waiting for your approval")
                                    @if (alreadyApproved && !string.IsNullOrWhiteSpace(Model.Step2ApprovedBy))
                                    {
                                        <span class="en-check-note">
                                            By @(Model.Step2ApprovedBy)@(Model.Step2ApprovedAtUtc.HasValue ? $" on {Model.Step2ApprovedAtUtc.Value.ToLocalTime():dd MMM yyyy HH:mm}" : "")
                                        </span>
                                    }
                                </span>
                            </li>
                        </ul>
                    </div>
                    <div class="en-card-foot" style="display:grid;gap:8px">
                        @if (alreadyApproved)
                        {
                            <a class="en-btn en-btn-primary en-btn-block" href="@batchesUrl">Continue to Batches, Printing and Sending →</a>
                        }
                        else
                        {
                            <button type="button" class="en-btn en-btn-primary en-btn-block" data-en-open="enApproveModal" @(canApprove ? "" : "disabled")>
                                @(isCla ? "Approve CLA Notice Preview" : "Approve Notice Preview")
                            </button>
                            @if (!canApprove)
                            {
                                <span style="font-size:12px">Fix the items marked <strong>!</strong> first.</span>
                            }
                        }
                    </div>
                </section>
            </aside>
        </div>
    }
</div>

@if (!alreadyApproved && Model.PreviewFound)
{
    <!-- Confirm approval -->
    <div class="en-modal" id="enApproveModal" role="dialog" aria-modal="true" aria-labelledby="enApproveTitle">
        <div class="en-modal-dialog">
            <div class="en-modal-head">
                <div class="en-modal-icon" aria-hidden="true">✓</div>
                <div>
                    <h2 class="en-modal-title" id="enApproveTitle">Approve this notice preview?</h2>
                    <p class="en-modal-sub">@NoticeName(Model.Notice)</p>
                </div>
                <button type="button" class="en-modal-x" data-en-close aria-label="Close">&times;</button>
            </div>
            <div class="en-modal-body">
                <dl class="en-kv">
                    <div><dt>Roll</dt><dd>@Model.RollShortCode — @Model.RollName</dd></div>
                    <div><dt>Version</dt><dd>@Model.Version</dd></div>
                </dl>
                <p style="margin:14px 0 0;font-size:13.5px">
                    @if (isCla)
                    {
                        <text>This approves the CLA letter. No emails go to property owners yet — the next stage prints the letters and checks the appeal packs.</text>
                    }
                    else
                    {
                        <text>This makes the notice available under <strong>Batches, Printing and Sending</strong>. No notices go to ratepayers yet.</text>
                    }
                </p>
            </div>
            <div class="en-modal-foot">
                <button type="button" class="en-btn en-btn-ghost" data-en-close>Cancel</button>
                <form asp-controller="Workflow" asp-action="Step2Approve" method="post" data-en-busy="Approving…">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="settingsId" value="@Model.SettingsId" />
                    @* Post the enum name (e.g. S52AppealDecision) — "S52Appeal" does not bind to PreviewVariant *@
                    <input type="hidden" name="variant" value="@GV23_Notice.Controllers.WorkflowController.PreviewVariantParser.Parse(selectedVariant)" />
                    <input type="hidden" name="mode" value="single" />
                    <input type="hidden" name="appealNo" value="@Model.AppealNo" />
                    <button type="submit" class="en-btn en-btn-primary" data-en-autofocus>Yes, Approve</button>
                </form>
            </div>
        </div>
    </div>
}
