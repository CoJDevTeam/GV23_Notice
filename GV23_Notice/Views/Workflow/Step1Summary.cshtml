@model GV23_Notice.Models.Workflow.ViewModels.WorkflowStep1SummaryVm
@{
    ViewData["Title"] = "Date Configuration Summary";
    // Direct links still work: the summary opens as a modal over a light page.
}

<div class="en-page">
    <div class="en-pagehead">
        <div>
            <div class="en-eyebrow">Step 1 of 3</div>
            <h1 class="en-title">Date Configuration Summary</h1>
            <p class="en-sub">Check the dates, then approve to continue to the notice preview.</p>
        </div>
        <div class="en-actions">
            <button type="button" class="en-btn en-btn-primary" data-en-open="enSummaryModal">Show Summary</button>
            <a class="en-btn en-btn-ghost" asp-controller="Workflow" asp-action="Step1" asp-route-settingsId="@Model.SettingsId">Edit Dates</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="en-alert en-alert-err">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="en-alert en-alert-ok">@TempData["Success"]</div>
    }
</div>

<partial name="_DateSummaryModal" model="Model" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            window.eNotice.openModal(document.getElementById('enSummaryModal'));
        });
    </script>
}
