@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@inject IAuthorizationService AuthorizationService

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var canAdmin = (await AuthorizationService.AuthorizeAsync(User, "ValuationAdminCreateApprove")).Succeeded;
    var canSearch = (await AuthorizationService.AuthorizeAsync(User, "ValuationAdminSearchDownload")).Succeeded;
    var canStep3 = (await AuthorizationService.AuthorizeAsync(User, "DataTeamCreateBatchPrint")).Succeeded;

    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "User";
    var shortName = fullName.Contains("\\") ? fullName.Split("\\").Last() : fullName;
    var initials = string.Concat(
        shortName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                 .Take(2).Select(w => char.ToUpper(w[0])));
    if (initials.Length == 0) initials = "U";
    var roleName = User.FindFirst(ClaimTypes.Role)?.Value ?? "";

    bool Is(string ctrl, params string[] acts) =>
        string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase) &&
        (acts.Length == 0 || acts.Any(a => string.Equals(action, a, StringComparison.OrdinalIgnoreCase)));

    // Which drawer item is active
    bool navHome = Is("Home");
    bool navDates = Is("Workflow", "Step1", "Step1Summary");
    bool navPreview = Is("Workflow", "Step2", "SettingsLibrary", "Step2EmailSuccess");
    bool navProcess = (Is("Step3") && !Is("Step3", "SendStats")) || Is("Workflow", "Step3Kickoff", "Step3Landing");
    bool navStats = Is("Stats") || Is("Step3", "SendStats");
    bool navSearch = Is("NoticeSearch");
    bool navCorrections = Is("NoticeCorrection");

    string A(bool on) => on ? "en-nav-link active" : "en-nav-link";
    string? Cur(bool on) => on ? "page" : null;

    var pageTitle = ViewData["Title"]?.ToString()?.Split('—').FirstOrDefault()?.Trim() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0c" />
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "eNotice" : $"{pageTitle} — eNotice")</title>
    <script type="importmap"></script>
    <link href="~/assets/img/COJ_Logo.png" rel="icon">
    <link href="~/assets/img/COJ_Logo.png" rel="apple-touch-icon">

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GV23_Notice.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enotice.css" asp-append-version="true" />

    <script>
        // Restore the collapsed drawer before first paint (desktop only)
        (function () {
            try {
                if (window.innerWidth >= 1200 && localStorage.getItem('enotice.rail') === '1')
                    document.documentElement.classList.add('en-rail-pending');
            } catch (e) { }
        })();
    </script>
</head>
<body class="en-body">
    <script>
        if (document.documentElement.classList.contains('en-rail-pending')) document.body.classList.add('en-rail');
    </script>

    <a href="#en-content" class="en-skip">Skip to content</a>

    <!-- ══ DRAWER ══════════════════════════════════════════════ -->
    <aside class="en-drawer" id="enDrawer" aria-label="Main navigation">

        <div class="en-drawer-head">
            <a asp-controller="Home" asp-action="Index" class="en-brand" title="eNotice home">
                <span class="en-brand-mark" aria-hidden="true">e</span>
                <span class="en-brand-text">
                    <span class="en-brand-name">e<span>Notice</span></span>
                    <span class="en-brand-sub d-block">City of Johannesburg</span>
                </span>
            </a>
            <button type="button" class="en-icon-btn en-rail-toggle" id="enRailToggle" title="Collapse menu" aria-label="Collapse menu">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><polyline points="15 18 9 12 15 6" /></svg>
            </button>
            <button type="button" class="en-icon-btn en-drawer-close" id="enDrawerClose" aria-label="Close menu">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
            </button>
        </div>

        <nav class="en-nav">
            <a asp-controller="Home" asp-action="Index" class="@A(navHome)" aria-current="@Cur(navHome)" title="Dashboard">
                <span class="en-nav-ico">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1" /><rect x="14" y="3" width="7" height="5" rx="1" /><rect x="14" y="12" width="7" height="9" rx="1" /><rect x="3" y="16" width="7" height="5" rx="1" /></svg>
                </span>
                <span class="en-nav-text">Dashboard</span>
            </a>

            <div class="en-nav-section">Notice Workflow</div>
            <div class="en-nav-section-gap"></div>

            @if (canAdmin)
            {
                <a asp-controller="Workflow" asp-action="Step1" class="@A(navDates)" aria-current="@Cur(navDates)" title="Step 1 — Date Configuration">
                    <span class="en-nav-ico"><span class="en-nav-step">1</span></span>
                    <span class="en-nav-text">
                        Date Configuration
                        <span class="en-nav-hint">Set the notice dates and approve</span>
                    </span>
                </a>

                <a asp-controller="Workflow" asp-action="SettingsLibrary" class="@A(navPreview)" aria-current="@Cur(navPreview)" title="Step 2 — Notice Preview and Approval">
                    <span class="en-nav-ico"><span class="en-nav-step">2</span></span>
                    <span class="en-nav-text">
                        Notice Preview and Approval
                        <span class="en-nav-hint">Check the notice, then approve</span>
                    </span>
                </a>
            }

            @if (canStep3)
            {
                <a asp-controller="Step3" asp-action="Index" class="@A(navProcess)" aria-current="@Cur(navProcess)" title="Step 3 — Batches, Printing and Sending">
                    <span class="en-nav-ico"><span class="en-nav-step">3</span></span>
                    <span class="en-nav-text">
                        Batches, Printing and Sending
                        <span class="en-nav-hint">Create batch, print, send notices</span>
                    </span>
                </a>
            }

            <a asp-controller="Stats" asp-action="Index" class="@A(navStats)" aria-current="@Cur(navStats)" title="Notice Statistics">
                <span class="en-nav-ico">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10" /><line x1="18" y1="20" x2="18" y2="4" /><line x1="6" y1="20" x2="6" y2="16" /></svg>
                </span>
                <span class="en-nav-text">
                    Notice Statistics
                    <span class="en-nav-hint">Sent, failed and pending notices</span>
                </span>
            </a>

            @if (canSearch)
            {
                <div class="en-nav-section">Tools</div>
                <div class="en-nav-section-gap"></div>

                <a asp-controller="NoticeSearch" asp-action="Index" class="@A(navSearch)" aria-current="@Cur(navSearch)" title="Notice Search">
                    <span class="en-nav-ico">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    </span>
                    <span class="en-nav-text">Notice Search</span>
                </a>

                <a asp-controller="NoticeCorrection" asp-action="Index" class="@A(navCorrections)" aria-current="@Cur(navCorrections)" title="Notice Corrections">
                    <span class="en-nav-ico">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                    </span>
                    <span class="en-nav-text">Notice Corrections</span>
                </a>
            }

            @if (!canAdmin)
            {
                <a asp-controller="Workflow" asp-action="SettingsLibrary" class="@A(navPreview)" aria-current="@Cur(navPreview)" title="Saved Configurations">
                    <span class="en-nav-ico">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                    </span>
                    <span class="en-nav-text">Saved Configurations</span>
                </a>
            }
        </nav>

        <div class="en-drawer-foot" title="@shortName">
            <div class="en-avatar" aria-hidden="true">@initials</div>
            <div class="en-user">
                <div class="en-user-name">@shortName</div>
                @if (!string.IsNullOrWhiteSpace(roleName))
                {
                    <div class="en-user-role">@roleName</div>
                }
            </div>
        </div>
    </aside>

    <div class="en-scrim" id="enScrim" aria-hidden="true"></div>

    <!-- ══ MAIN ═════════════════════════════════════════════════ -->
    <div class="en-main">
        <header class="en-topbar">
            <button type="button" class="en-menu-btn" id="enMenuBtn" aria-label="Open menu" aria-controls="enDrawer" aria-expanded="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
            </button>
            <div class="en-crumb">@pageTitle</div>
            <div class="en-clock" id="enClock" aria-hidden="true"></div>
        </header>

        <main class="en-content" id="en-content">@RenderBody()</main>

        <footer class="en-footer">
            <span>&copy; @DateTime.Now.Year City of Johannesburg — Valuation Services · eNotice</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/enotice.js" asp-append-version="true"></script>
    <script>
        (function () {
            // Clock
            var el = document.getElementById('enClock');
            if (el) {
                var D = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
                var M = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                var p = function (n) { return String(n).padStart(2, '0'); };
                var tick = function () {
                    var d = new Date();
                    el.textContent = D[d.getDay()] + ' ' + p(d.getDate()) + ' ' + M[d.getMonth()] + ' ' + d.getFullYear() + '  ' + p(d.getHours()) + ':' + p(d.getMinutes());
                };
                tick(); setInterval(tick, 15000);
            }

            // Drawer
            var body = document.body;
            var menuBtn = document.getElementById('enMenuBtn');
            var railBtn = document.getElementById('enRailToggle');
            var closeBtn = document.getElementById('enDrawerClose');
            var scrim = document.getElementById('enScrim');
            var drawer = document.getElementById('enDrawer');
            var desktop = window.matchMedia('(min-width: 1200px)');

            function saveRail(on) { try { localStorage.setItem('enotice.rail', on ? '1' : '0'); } catch (e) { } }

            function openDrawer() {
                body.classList.add('en-drawer-open');
                body.classList.add('en-lock');
                menuBtn.setAttribute('aria-expanded', 'true');
                var first = drawer.querySelector('.en-nav-link');
                if (first) first.focus({ preventScroll: true });
            }
            function closeDrawer() {
                body.classList.remove('en-drawer-open');
                body.classList.remove('en-lock');
                menuBtn.setAttribute('aria-expanded', 'false');
            }

            menuBtn.addEventListener('click', function () {
                if (desktop.matches) {
                    var on = !body.classList.contains('en-rail');
                    body.classList.toggle('en-rail', on);
                    saveRail(on);
                } else if (body.classList.contains('en-drawer-open')) {
                    closeDrawer();
                } else {
                    openDrawer();
                }
            });

            if (railBtn) railBtn.addEventListener('click', function () { body.classList.add('en-rail'); saveRail(true); });
            if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
            scrim.addEventListener('click', closeDrawer);
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && body.classList.contains('en-drawer-open')) closeDrawer(); });

            // On tablet/phone, close the overlay drawer after choosing a page
            drawer.querySelectorAll('.en-nav-link').forEach(function (a) {
                a.addEventListener('click', function () { if (!desktop.matches) closeDrawer(); });
            });

            // Leaving phone/tablet size closes the overlay drawer
            desktop.addEventListener('change', function () { closeDrawer(); });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
